# Gluetun service-specific configuration.
# Seeded into configs/gluetun/.env by `make bootstrap`, then gitignored. See
# README.md section 3.1 (Gluetun VPN Gateway) and docs/VPN_PROVIDERS.md.

### PROVIDER
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# Kernel WireGuard (no /dev/net/tun needed, required for rootless Podman).
WIREGUARD_IMPLEMENTATION=kernelspace
# For WireGuard providers, paste the private key into configs/gluetun/.secret.
WIREGUARD_PRIVATE_KEY_SECRETFILE=/gluetun/.secret

### SERVER SELECTION
# Which server to connect to — see gluetun docs for SERVER_NAMES, SERVER_HOSTNAMES, etc.
SERVER_COUNTRIES=Netherlands

### PORT FORWARDING
# Required for qBittorrent to be connectable.
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
# When the forwarded port changes, update qBittorrent automatically.
# GLUETUN_SERVICES_IP and QBITTORRENT_HTTPS_PORT are injected from the main .env at container
# startup (via env_file: [".env", ...] in docker-compose-vpn.yml) and expand in the inner shell.
VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'for i in $(seq 0 11); do wget -q -O /dev/null --no-check-certificate --post-data="json=%7B%22listen_port%22%3A{{PORTS}}%7D" https://$GLUETUN_SERVICES_IP:$QBITTORRENT_HTTPS_PORT/api/v2/app/setPreferences 2>/dev/null && echo "[PORTFWD] qBittorrent listen port set to {{PORTS}}" && exit 0; [ $i -lt 11 ] && sleep 10; done; echo "[PORTFWD] WARN: qBittorrent unreachable after 2 min, port {{PORTS}} not applied"'

### CONTROL SERVER
# Used by VPN_PORT_FORWARDING_UP_COMMAND above.
HTTP_CONTROL_SERVER_ADDRESS=:8000

### HTTP PROXY
# Internal HTTP proxy for tagged Prowlarr indexers. Do not publish this port on
# the host; containers on the services bridge can reach it as gluetun:8888.
HTTPPROXY=on
HTTPPROXY_LISTENING_ADDRESS=:8888
HTTPPROXY_STEALTH=on
HTTPPROXY_LOG=off

### FIREWALL
# Allow traffic to local bridge networks without routing through VPN.
# 172.16.0.0/12 covers both services (172.28.0.0/24) and observability (172.29.0.0/24) bridges.
# 10.89.0.0/16 covers Podman's WAN bridge (10.89.x.x) without including the VPN tunnel
# subnet (10.2.0.0/x) — keeping 10.0.0.0/8 here would misroute NAT-PMP port-forwarding
# requests away from the VPN tunnel and break port forwarding.
FIREWALL_OUTBOUND_SUBNETS=172.16.0.0/12,10.89.0.0/16,192.168.0.0/16
# Deny all inbound on VPN interface except the auto-managed port-forwarded peer port.
FIREWALL_VPN_INPUT_PORTS=
# Deny all inbound on bridge interfaces beyond what Docker network membership controls.
FIREWALL_INPUT_PORTS=
