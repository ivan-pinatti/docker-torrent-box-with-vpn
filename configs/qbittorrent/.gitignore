# # Ignore everything in this directory
*

# # Except
!.gitignore
!.env
!.env.secrets.example

# Secret files consumed via compose `secrets:`. Real values stay ignored by
# the blanket `*` above; only the .example templates are committed.
!secrets/
secrets/*
!secrets/*.example

# config file
!config/
config/*
!config/qBittorrent
config/qBittorrent/*
# qBittorrent.conf itself stays ignored: qBittorrent rewrites it on shutdown,
# and WebUI\Password_PBKDF2 in it is the live WebUI credential. Only the
# seed template is committed, and `make bootstrap` copies it into place.
!config/qBittorrent/qBittorrent.conf.example
!config/qBittorrent/categories.json
!config/qBittorrent/watched_folders.json
