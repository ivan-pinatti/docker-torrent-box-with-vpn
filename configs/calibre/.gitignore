# Ignore everything in this directory
*

# Except .gitignore and dotenv file
!.gitignore
!.env
!.env.secrets.example

# Secret files consumed via compose `secrets:`. Real values stay ignored
# by the blanket `*` above; only the .example templates are committed.
!secrets/
secrets/*
!secrets/*.example

# config file
!config/
config/*
!config/.config/
config/.config/*
!config/.config/calibre
config/.config/calibre/*
# Calibre rewrites these on shutdown: window geometry, per-install UUID,
# library usage counters. Only the sanitized seeds are committed; `make
# bootstrap` copies them into place.
!config/.config/calibre/gui.json.example
!config/.config/calibre/gui.py.json.example
!config/.config/calibre/global.py.json.example
!config/.config/calibre/dynamic.pickle.json.example

# pre-start init scripts
!custom-cont-init.d/
!custom-cont-init.d/10-fix-library.sh
