# Ignore everything in this directory
*

# Except .gitignore and dotenv file
!.gitignore
!.env
!.env.secrets.example

# config files
!config/
config/*
!config/bookmarks.yaml
!config/docker.yaml
!config/kubernetes.yaml
!config/proxmox.yaml
!config/settings.yaml
!config/widgets.yaml
# services.yaml is generated by scripts/generate-homepage-services.py from
# services.yaml.template, filtered down to whichever apps and profile
# groups are actually enabled in .env; see that template's own comment.
!config/services.yaml.template
!config/custom.js
!config/custom.css
