# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/homepage/.env.
HOMEPAGE_VAR_SONARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_RADARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_READARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_BAZARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_PROWLARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_LIDARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_WHISPARR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_MYLAR_API_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_QBITTORRENT_USER=admin
HOMEPAGE_VAR_QBITTORRENT_PASS=changeme
# SABnzbd's API key is not here: it is supplied as a compose secret and read
# via HOMEPAGE_FILE_SABNZBD_API_KEY, which points at the mounted file rather
# than holding the value. services.yaml uses {{HOMEPAGE_FILE_SABNZBD_API_KEY}}.
HOMEPAGE_VAR_JELLYFIN_KEY=0123456789abcdef0123456789abcdef
HOMEPAGE_VAR_AUDIOBOOKSHELF_API_KEY=changeme
HOMEPAGE_VAR_CALIBREWEB_USER=calibre
HOMEPAGE_VAR_CALIBREWEB_PASS=changeme
HOMEPAGE_VAR_GRAFANA_AUTH=changeme
