# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/nzbget/.env.
# Empty: NZBGET_USER/PASS are supplied as compose secrets and read via
# FILE__NZBGET_USER/FILE__NZBGET_PASS instead. See
# configs/nzbget/secrets/ and docs/COMPOSE_CONVENTIONS.md.
