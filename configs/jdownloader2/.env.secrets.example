# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/jdownloader2/.env.
# Empty: WEB_AUTHENTICATION_USERNAME/PASSWORD are supplied as compose secrets
# named CONT_ENV_WEB_AUTHENTICATION_USERNAME and
# CONT_ENV_WEB_AUTHENTICATION_PASSWORD, which the image's own /init loader
# turns into those environment variables by stripping the CONT_ENV_ prefix.
# See configs/jdownloader2/secrets/ and the comment in
# docker-compose-torrent.yml.
