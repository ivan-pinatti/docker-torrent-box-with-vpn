# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/jdownloader2/.env.
# NOT migrated to compose secrets: jlesage/docker-baseimage-gui's documented
# CONT_ENV_<VAR> Docker-secrets convention does not actually exist in this
# pinned image version (verified directly: no script or binary anywhere in
# the image references CONT_ENV, and a live rotation test confirmed the
# mounted secret is never picked up, silently leaving the old password
# active). Revisit if a future JDOWNLOADER2_VERSION adds real support.
WEB_AUTHENTICATION_USERNAME=jdownloader2
WEB_AUTHENTICATION_PASSWORD=changeme # pragma: allowlist secret
