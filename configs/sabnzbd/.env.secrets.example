# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/sabnzbd/.env.
# The API key is not here: it is shared with sabnzbd_exporter and homepage,
# so it lives in configs/sabnzbd/secrets/api_key.txt and is delivered to each
# consumer via compose `secrets:`. See docs/COMPOSE_CONVENTIONS.md.
SABNZBD_USERNAME=sabnzbd
SABNZBD_PASSWORD=sabnzbd
SABNZBD_NZB_KEY=0123456789abcdef0123456789abcdef
