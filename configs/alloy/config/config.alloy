// Nginx access logs
local.file_match "nginx_access" {
  path_targets = [{"__path__" = "/nginxlogs/*-access.log"}]
}

loki.source.file "nginx_access" {
  targets    = local.file_match.nginx_access.targets
  forward_to = [loki.process.nginx_access.receiver]
}

loki.process "nginx_access" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      job = "nginx-access",
    }
  }

  stage.regex {
    source     = "filename"
    expression = `.*\/(?P<service>[^/]+)-access\.log`
  }

  stage.labels {
    values = {
      service = "",
    }
  }

  stage.regex {
    expression = `^(?P<remote_addr>\S+) \S+ - \S+ \[[^\]]+\] "[^"]*" (?P<status>\d+)`
  }

  stage.labels {
    values = {
      status = "",
    }
  }

  stage.regex {
    expression = `(?P<cache_status>HIT|MISS|BYPASS|EXPIRED|STALE|UPDATING|REVALIDATED|-) "`
  }

  stage.labels {
    values = {
      cache_status = "",
    }
  }
}

