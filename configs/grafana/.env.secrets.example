# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and overrides configs/grafana/.env.
# GRAFANA_SMTP_USER/PASSWORD are not here: they are supplied as compose
# secrets and read directly by grafana.ini via Grafana's own $__file{}
# config provider. See configs/grafana/secrets/ and
# docs/COMPOSE_CONVENTIONS.md.
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_HOST=email-smtp.us-east-1.amazonaws.com:587
GRAFANA_SMTP_FROM_ADDRESS=alerts@example.com
GRAFANA_TELEGRAM_TOKEN=1234567890:AAExampleFakeTelegramBotToken1234567
GRAFANA_TELEGRAM_CHAT_ID=100200300
GRAFANA_ALERT_EMAIL_TO=alerts@example.com
