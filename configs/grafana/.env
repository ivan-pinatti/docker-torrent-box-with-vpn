# SMTP via AWS SES (override real credentials in .env.secrets)
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_HOST=email-smtp.us-east-1.amazonaws.com:587
GRAFANA_SMTP_USER=AKIAEXAMPLEFAKEKEY01  # pragma: allowlist secret
GRAFANA_SMTP_PASSWORD=BExampleFakeSesSmtpPassword1234567890AbCdEf  # pragma: allowlist secret
GRAFANA_SMTP_FROM_ADDRESS=alerts@example.com

# Telegram (clear GRAFANA_TELEGRAM_TOKEN to disable delivery)
GRAFANA_TELEGRAM_TOKEN=1234567890:AAExampleFakeTelegramBotToken1234567
GRAFANA_TELEGRAM_CHAT_ID=100200300

# Alert recipient
GRAFANA_ALERT_EMAIL_TO=alerts@example.com
