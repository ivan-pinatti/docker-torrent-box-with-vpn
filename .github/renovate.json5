{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependabot handles pre-commit hooks, GitHub Actions, and the Python
  // packages in tests/requirements.txt — see dependabot.yml.
  // Renovate handles Docker image versions pinned in .env.example, and the Python
  // packages pinned inline in workflow `run:` steps, both via # renovate:
  // annotations. Those inline pins are the seam between the two tools:
  // Dependabot's pip ecosystem reads requirements files and would never see a
  // `pip install foo==1.2.3` in a workflow, so a pin left unwatched there rots
  // silently, which is how CI ended up installing whatever version of
  // podman-compose happened to be current.
  extends: ["config:recommended"],

  // Kept on for its warnings, not for the overview of pending updates. Two
  // lookup failures sat unseen on Mend's hosted dashboard for weeks: nothing
  // in this repository surfaces them, and during that stretch the checkov pin
  // in .pre-commit-config.yaml silently stopped updating, drifting three
  // patch versions behind the copy in the workflow. Renovate Config cannot
  // catch that class of problem, because the config is valid, it just does
  // the wrong thing; an issue here would have shown it. The cost is one
  // standing issue that never closes on its own, taken deliberately.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // The default day for anything not named in a group below. Each group in
  // packageRules carries its own schedule, so this is only reached by images
  // that stay ungrouped on purpose. See docs/DEPENDENCY_UPDATES.md for the
  // full weekday layout and the reasoning behind spreading updates across the
  // week instead of opening everything on one day.
  //
  // Only creating. updateNotScheduled defaults to true, so branches that
  // already exist are still rebased outside the window, which matters here
  // because required checks are strict: every merge puts the other open pull
  // requests behind, and they would sit until the next scheduled day if
  // Renovate could not touch them. This was misread once as a reason not to
  // restore the window at all.
  //
  // Lifted briefly on 2026-08-18 to produce a bot pull request on demand, which
  // is the only way to observe whether CodeRabbit auto-reviews one. It does not.
  // Across 16 bot pull requests it posted a `CodeRabbit` status on exactly one,
  // #56, which is the one asked by hand, while all 8 human pull requests in the
  // same window got one automatically. GitHub's 2026-08-17 webhook incident is
  // ruled out, since the retest ran hours after it resolved. Raised with their
  // support.
  //
  // Worth weighing if this is ever reconsidered: the window costs up to seven
  // days on top of the seven minimumReleaseAge already imposes, and it existed
  // to give a person one sitting a week to work through the batch. Nothing is
  // worked through by hand any more.
  schedule: ["before 7am on saturday"],

  // `docker` is not here on purpose. It is added by the datasource rule in
  // packageRules below, so a pypi or go update no longer arrives tagged as a
  // container image: #54, #64, #67 and #70 all carried it wrongly. The labels
  // are load bearing now that bot-auto-merge.yml keys on `automerge`, so one
  // that says the wrong thing is worth correcting rather than tolerating.
  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default, overridden per update type in packageRules below. Kept as the
  // default rather than inverted, so a datasource or update type nobody thought
  // about arrives needing a person.
  automerge: false,

  // GitHub's own auto-merge, armed by Renovate when it opens the pull request
  // and completed by GitHub once branch protection is satisfied. The default,
  // stated because it is load-bearing: the alternative is Renovate merging
  // through the API on its own judgement of whether the checks passed, and
  // Renovate cannot see a required status context that is *absent*, which is
  // exactly the state a pull request is in until the integration suite
  // publishes `Tests Verified`. Handing the decision to GitHub means the check
  // it cannot see is the one thing it cannot skip.
  platformAutomerge: true,
  automergeStrategy: "squash",

  // A cooling window before an update is offered at all. This is the main
  // defense against a compromised upstream release, and it is a defense the
  // scanners do not provide: Trivy runs `fs` against the working tree and never
  // inspects the images a bump points at, and every scanner matches published
  // advisories, which a fresh supply chain attack has none of. Most compromised
  // releases are spotted and pulled within hours to days, so waiting is what
  // turns "we merged it first" into "it was already yanked". See
  // docs/HARDENING.md.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening one
  // that is not allowed to merge yet. Without this the window would still be
  // honoured, but a week of pull requests would sit there looking blocked for
  // no visible reason.
  internalChecksFilter: "strict",

  // The exception, and the reason the window can be as long as a week: a fix
  // for a known vulnerability is not made safer by aging, and this stack faces
  // the internet. null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  // Required status checks are strict on `main`, so a pull request that falls
  // behind cannot merge until it is updated. Renovate doing the rebase keeps
  // the push attributed to renovate[bot]: the approval on these pull requests
  // is github-actions[bot]'s, and `requireLastPushApproval` needs the approver
  // and the pusher to be different accounts, which would stop being true if
  // GitHub's auto-merge did the update instead.
  rebaseWhen: "behind-base-branch",

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose. Later rules win on any key they share, and
    // the group rules below deliberately share none of these: they set names
    // and labels, not policy. A rule that means to keep something manual has to
    // come after this one.
    //
    // The label is not decoration. bot-auto-merge.yml approves a Renovate pull
    // request only when it carries this label, so the decision about which
    // bumps are eligible lives here, once, instead of being restated in a
    // workflow expression free to drift from it. A major bump matches nothing
    // here, arrives unlabelled, and waits for review.
    //
    // digest and pin are in the list because a digest bump is how a rebuilt tag
    // reaches this repository at all: leaving them out would mean the pins that
    // pinDigests maintains could only be refreshed by hand, which is how they
    // rot.
    {
      matchUpdateTypes: ["patch", "minor", "digest", "pin", "pinDigest"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // The `docker` label, applied by datasource instead of to everything. It
    // used to live in the root `labels` above, so every pypi and go update
    // arrived tagged as a container image. This covers both customManagers
    // that set `datasourceTemplate: "docker"`, and correctly leaves out the
    // ones taking their datasource from the annotation, which is how checkov,
    // zizmor, podman-compose and gitleaks stop being called images.
    //
    // addLabels accumulates rather than replacing, so this composes with the
    // rule above and with the group rules below instead of racing them.
    {
      matchDatasources: ["docker"],
      addLabels: ["docker"],
    },
    // The two base images this repository builds a wrapper over, held out of
    // pinDigests. Each is consumed twice from one variable: as the base the
    // wrapper is built on (`BASE_VERSION` in build/lazylibrarian/Dockerfile and
    // build/mylar/Dockerfile) and as the tag of the locally built result
    // (`image: lazylibrarian-calibre:${LAZYLIBRARIAN_VERSION}` and
    // `image: mylar-pyopenssl:${MYLAR_VERSION}` in
    // docker-compose-servarr.yml). A digest is legal in the first position and
    // not in the second, because an image being built can only be given a tag:
    // `podman build -t name:tag@sha256:...` is not a valid reference, so a
    // digest appended to either variable stops the wrapper building at all.
    //
    // Not hypothetical for lazylibrarian. It has carried an annotation with no
    // digest since the other pins got theirs, with pinDigests on globally, so
    // the pinDigest update that breaks it was already pending; docs/TODO.md read
    // that gap the other way round and asked for the digest to be added. mylar
    // would have joined it the moment its annotation landed.
    //
    // Kept separate from the hold below, which switches both of these off for a
    // different and temporary reason. This constraint is permanent: it is a
    // property of building a wrapper image, not of the patches those two happen
    // to carry today, so it has to outlive the hold rather than be folded into
    // it. tests/test_renovate_pins.py carries the matching exemption, so the
    // missing digest cannot be mistaken for an oversight.
    {
      matchPackageNames: [
        "docker.io/linuxserver/lazylibrarian",
        "docker.io/linuxserver/mylar3",
      ],
      pinDigests: false,
    },
    // The four images whose containers run a file bind mounted out of
    // patches/, held at a fixed version until the patch that made them special
    // is gone. sabnzbd, lazylibrarian, mylar and jdownloader-2, matching the
    // `./patches/` volumes in docker-compose-nzb.yml,
    // docker-compose-servarr.yml and docker-compose-torrent.yml.
    //
    // A patch shadows one file inside the image, and nothing in this repository
    // can tell whether the shadowing copy still matches the file it replaces.
    // An unattended bump therefore pairs patched old source with new upstream
    // code, and the result starts, reports healthy and passes the suite while
    // being subtly wrong. mylar makes the size of that concrete: its first
    // offered bump is v0.9.0-ls252 to v0.11.0-ls268, which `loose` versioning
    // calls a minor because both share major 0, so it would have merged
    // unattended across two upstream minor releases with five patched files
    // mounted over it.
    //
    // A digest refresh is held too, not only a version bump. Two of the four
    // patches shadow a file that belongs to the image rather than to the
    // application: patches/sabnzbd/svc-sabnzbd/run is an s6 service script and
    // patches/jdownloader2/10-webauth.sh is a baseimage-gui init script, and a
    // rebuild of the same tag is exactly how either of those changes underneath
    // the patch. docs/TODO.md records the jdownloader-2 case in those terms
    // already: the fix it is waiting for arrives as a baseimage-gui bump inside
    // an image whose tag need not move.
    //
    // The alternative was chasing each upstream release with a fresh patch,
    // which is work with no end date and no test that would catch getting it
    // wrong. Each of the four has an open item in docs/TODO.md for dropping its
    // patch, and dropping one is what unfreezes its pin. Until then the pin is
    // deliberately fixed rather than accidentally frozen, which is the whole
    // distinction the rest of this file is about, and
    // tests/test_renovate_pins.py fails when a service grows a patch mount
    // whose image is not named here.
    //
    // Worth knowing what this gave up: sabnzbd and jdownloader-2 were both
    // flowing, and merging unattended, before this. It costs less than it looks
    // like, because GitHub raises no vulnerability alert for a container image
    // at all, so neither pin had a security path that this closes; see
    // docs/DEPENDENCY_UPDATES.md.
    {
      matchPackageNames: [
        "docker.io/linuxserver/sabnzbd",
        "docker.io/linuxserver/lazylibrarian",
        "docker.io/linuxserver/mylar3",
        "docker.io/jlesage/jdownloader-2",
      ],
      enabled: false,
    },
    // The arr suite. Grouped to cut the pull request volume these seven images
    // would otherwise open one at a time, not because they share a release
    // cadence. They do not: image creation dates measured with skopeo inspect
    // on 2026-08-18 run from readarr on 2025-06-27 to prowlarr and sonarr in
    // early August 2026, fifteen months apart across the full set, so grouping
    // on "they release together" would be fiction. These are also the images
    // that have not broken anything recently, unlike the download clients kept
    // isolated further down, which is the actual reason they are grouped while
    // those are not.
    {
      matchDatasources: ["docker"],
      matchPackageNames: [
        "docker.io/linuxserver/sonarr",
        "docker.io/linuxserver/radarr",
        "docker.io/linuxserver/lidarr",
        "docker.io/linuxserver/readarr",
        "docker.io/linuxserver/prowlarr",
        "docker.io/linuxserver/bazarr",
        "ghcr.io/recyclarr/recyclarr",
      ],
      groupName: "arr suite",
      groupSlug: "arr-suite",
      schedule: ["before 7am on thursday"],
    },
    // The observability stack. Every image in it sits behind a profile that
    // ships disabled. Grouped for pull request volume rather than tidiness now:
    // it was three images until the eight unannotated pins in .env.example were
    // given `# renovate:` annotations, and eight more pull requests a week for
    // a stack nobody has enabled would be noise.
    //
    // The integration suite does exercise these, which was not true when this
    // group was first written. CI applies .env.tests through
    // `make enable_test_profiles`, so every profile here is enabled there, the
    // images are pulled and started, and the tests carrying the `observability`
    // marker run instead of skipping. That is what lets this group merge
    // unattended and be defensible rather than merely cheap, and it is why
    // docker.io/library/python
    // is in the list: it was held out entirely while nothing tested it, and
    // tests/test_observability.py now asserts that its exporter's own series
    // reach Prometheus and that the values match what .env asked compose for.
    //
    // docker.io/library/alpine, which log_rotator runs, is deliberately not
    // here. It is the one image in the stack whose profile ships enabled, so it
    // was the only one CI pulled and started before this group was tested at
    // all, and keeping it on its own schedule costs nothing now that the rest
    // are covered too.
    //
    // grafana/promtail used to be listed here and is gone from the repository
    // entirely; the stack uses Alloy now. Matching bare package names without
    // the registry also meant this rule matched 0 of its 5 listed members
    // before the rewrite in #90: see the depName note above the customManagers
    // below.
    {
      matchDatasources: ["docker"],
      matchPackageNames: [
        "docker.io/grafana/grafana-oss",
        "docker.io/prom/prometheus",
        "docker.io/grafana/loki",
        "docker.io/grafana/alloy",
        "gcr.io/cadvisor/cadvisor",
        "docker.io/prom/node-exporter",
        "quay.io/navidys/prometheus-podman-exporter",
        "docker.io/library/python",
        "docker.io/nginx/nginx-prometheus-exporter",
        "ghcr.io/esanchezm/prometheus-qbittorrent-exporter",
        "docker.io/msroest/sabnzbd_exporter",
      ],
      groupName: "observability stack",
      groupSlug: "observability",
      schedule: ["before 7am on friday"],
    },
    // Library and reading tools. Grouped for the same reason as the arr suite
    // above, to cut pull request volume, not because these five share a
    // release cadence. None of them touch the VPN namespace or a download
    // client, so none of the reasoning that keeps gluetun and the download
    // clients isolated below applies here.
    {
      matchDatasources: ["docker"],
      matchPackageNames: [
        "docker.io/linuxserver/calibre",
        "docker.io/linuxserver/calibre-web",
        "docker.io/linuxserver/lazylibrarian",
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/nperez0111/koreader-sync",
      ],
      groupName: "library and reading tools",
      groupSlug: "library-reading",
      schedule: ["before 7am on friday"],
    },
    // gluetun, flaresolverr, wireguard, every download client (qbittorrent,
    // sabnzbd, nzbget, nzbhydra2, jdownloader-2), jellyfin and homepage are
    // deliberately named in no group here, so each opens its own pull request
    // on the root schedule instead of sharing one with anything else. sabnzbd
    // and jdownloader-2 open nothing at all while the hold above stands; this
    // still describes where they land the day it is lifted. A group
    // is only as mergeable as its worst member, and the two bumps that broke
    // something this week, SABnzbd 5.0.4 and qBittorrent 5.2.2 (see
    // docs/TODO.md), were both download clients. Isolating them keeps one bad
    // image from blocking every other pull request a shared group would have
    // bundled it with. gluetun is what every download client's kill switch
    // depends on, so the same argument isolates it too. This is where the
    // former "vpn and network tools" and "media library servers" groups used
    // to sit; the first also listed ghcr.io/tprasadtp/protonwire, a package
    // with no corresponding pin anywhere in this repository, so it matched
    // nothing and is not carried forward.
    //
    // Four more pins stay ungrouped without that blast radius argument
    // applying, simply because there is no group they belong in.
    // docker.io/library/alpine is log_rotator's, and the reason it is not in
    // the observability group is written there. docker.io/linuxserver/mylar3 is the
    // base of a wrapper this repository builds itself, so a bump rebuilds an
    // image rather than pulling one. ghcr.io/notifiarr/notifiarr feeds a
    // service that is commented out in docker-compose-servarr.yml, and
    // docker.io/linuxserver/jackett feeds no service at all: both are watched
    // anyway, because an unwatched pin is the thing this change exists to stop,
    // and a year stale image is a worse starting point than a current one for
    // whoever turns either service back on.
    //
    // Lint and scanner tooling. Backs the pre-commit hooks and the workflow's
    // Security Reports SARIF job, both driven by the customManagers below,
    // grouped to cut the volume eight separate pins would otherwise open.
    // Spans three datasources (docker, pypi and go), so this rule matches on
    // depName alone rather than a matchDatasources value that could only cover
    // part of the list. Each depName here is the exact string the pin's own
    // `# renovate:` annotation declares, since that annotation, not the image
    // or package name written elsewhere in the same line, is what the two
    // customManagers below treat as authoritative for both datasource and
    // name.
    {
      matchPackageNames: [
        "aquasec/trivy",
        "zricethezav/gitleaks",
        "dotenvlinter/dotenv-linter",
        "hadolint/hadolint",
        "lycheeverse/lychee",
        "checkov",
        "zizmor",
        "github.com/zricethezav/gitleaks/v8",
      ],
      groupName: "lint and scanner tooling",
      groupSlug: "lint-scanner-tooling",
      schedule: ["before 7am on sunday"],
    },
    // The container runtime tooling CI installs, pinned inline in the
    // workflows. Grouped so the two copies of the pin always move in one pull
    // request: they are the same pin, and letting them drift apart would mean
    // the prerequisite job and the suite testing different tools.
    //
    // This used to be held out of automerge, on the grounds that podman-compose
    // is what talks to podman and a bump had to be proven by an actual suite
    // run, which only started when someone commented `/run-tests`. The suite now
    // starts itself for these pull requests, so the condition that kept this
    // manual is met by the thing it was waiting for. A podman-compose that
    // cannot stand the stack up fails the suite loudly, which is the whole
    // proof that was being asked for.
    //
    // The `ci-runtime` label stays. It marks the one bump that changes the
    // tooling the suite itself runs on, which is worth being able to find after
    // the fact when something starts behaving oddly in CI.
    {
      matchDatasources: ["pypi"],
      matchPackageNames: ["podman-compose"],
      groupName: "container runtime tooling",
      groupSlug: "ci-runtime",
      addLabels: ["ci-runtime"],
      schedule: ["before 7am on sunday"],
    },
  ],

  customManagers: [
    {
      customType: "regex",
      // Matches the pattern:
      //   # renovate: depName=<image> [versioning=<scheme>]
      //   VAR_VERSION=<currentValue>[@<currentDigest>]
      //
      // currentValue stops at the @ so the digest is captured separately.
      // Without its own group Renovate has nowhere to write an updated digest,
      // and the pins would quietly rot into permanently stale images, which is
      // worse than not pinning at all. The group is optional because two tags
      // are deliberately left floating (see .env.example).
      //
      // depName carries the full registry, not just the repository. The digest
      // has to be resolved where the image is actually fetched from: most
      // registries serve the same artifact, but prom/node-exporter v1.11.1 is
      // sha256:e9cff4fc on Docker Hub and sha256:0f422f62 on quay.io, so a
      // bare repository name would be ambiguous exactly where it matters.
      managerFilePatterns: ["/^\\.env\\.example$/"],
      matchStrings: [
        "# renovate: depName=(?<depName>[^\\s\\n]+)(?:\\s+versioning=(?<versioning>[^\\s\\n]+))?\\n[A-Z0-9_]+=(?<currentValue>[^@\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      // Matches the pattern, in any workflow:
      //   # renovate: datasource=<ds> depName=<package>
      //   pip install <package>==<currentValue>
      //
      // datasource and depName come from the annotation rather than being
      // hardcoded here, so a second inline pin needs an annotation and nothing
      // else. The package name in the command itself is matched loosely on
      // purpose: Renovate's regex engine has no backreferences, so it cannot be
      // tied back to depName, and the annotation is the authority anyway.
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s*\\n\\s*pip install [^\\s=]+==(?<currentValue>[^\\s]+)",
      ],
    },
    {
      customType: "regex",
      // The `additional_dependencies` pins in .pre-commit-config.yaml: gitleaks
      // (a Go module) and checkov (a pypi package). Neither is a container
      // image, which is the whole reason this is its own manager.
      //
      // These used to sit alongside the image patterns below, under that
      // manager's `datasourceTemplate: "docker"`. A template set on a manager
      // applies to every one of its matchStrings and wins over a `datasource`
      // captured by the pattern, so the annotations here were read and then
      // overridden, and Renovate spent weeks reporting:
      //
      //   Failed to look up docker package github.com/zricethezav/gitleaks/v8
      //   Failed to look up docker package checkov
      //
      // Silently, on the repository's Renovate dashboard rather than anywhere
      // this repository would notice. Meanwhile the second copy of the checkov
      // pin, in the workflow, updates through a different manager that has no
      // template, so the two drifted: the gate was still on 3.3.2 while the
      // SARIF report had reached 3.3.10. That is exactly the failure the
      // manager below warns about.
      //
      // No datasourceTemplate here, deliberately. The annotation is the
      // authority, and it is the only thing that can be, because the two
      // dependencies do not share a datasource.
      managerFilePatterns: ["/^\\.pre-commit-config\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s*\\n\\s*additional_dependencies: \\[\"[^\"]+?(?:==|@)(?<currentValue>v?[0-9][^\"]*)\"\\]",
      ],
    },
    {
      customType: "regex",
      // Versions pinned inside `repo: local` hooks in .pre-commit-config.yaml.
      //
      // Dependabot's pre-commit ecosystem updates the `rev:` of a hook
      // repository and nothing else, so these pins are invisible to it: the
      // `additional_dependencies` entries (gitleaks, checkov) and the container
      // image tags inside a hook's `entry:` (trivy, dotenv-linter, hadolint,
      // lychee). Before the MegaLinter removal they were all carried by that
      // single pinned image, and Dependabot did keep it current. Without this
      // manager they would silently rot, which for a secret scanner and two
      // security scanners is the worst place to have a stale pin.
      //
      // The image patterns tolerate lines between the annotation and the tag,
      // because `entry:` is a folded block scalar and a comment cannot live
      // inside one. Each one names its image literally on both sides rather
      // than capturing whatever image reference turns up first: a bounded
      // wildcard still selects a later, unrelated image when the annotated
      // command happens to carry no version of its own, and the result is a
      // pull request that bumps the wrong pin. Renovate's regex engine has no
      // backreferences, so the name has to be written twice to tie them
      // together. One line per image is the cost of that.
      // The workflow file is here too, not only .pre-commit-config.yaml. The
      // Security Reports job pins the same scanners a second time, because it
      // runs them in SARIF mode rather than through pre-commit, and the two
      // copies have to move together or the reports stop describing what the
      // gate actually enforces.
      managerFilePatterns: [
        "/^\\.pre-commit-config\\.yaml$/",
        "/^\\.github/workflows/pull-request-validation\\.yml$/",
      ],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>aquasec/trivy)[\\s\\S]{0,900}?aquasec/trivy:(?<currentValue>v?\\d[\\w.\\-]*)",
        "# renovate: datasource=docker depName=(?<depName>dotenvlinter/dotenv-linter)[\\s\\S]{0,900}?dotenvlinter/dotenv-linter:(?<currentValue>v?\\d[\\w.\\-]*)",
        "# renovate: datasource=docker depName=(?<depName>zricethezav/gitleaks)[\\s\\S]{0,900}?zricethezav/gitleaks:(?<currentValue>v?\\d[\\w.\\-]*)",
        "# renovate: datasource=docker depName=(?<depName>hadolint/hadolint)[\\s\\S]{0,900}?hadolint/hadolint:(?<currentValue>v?\\d[\\w.\\-]*)",
        "# renovate: datasource=docker depName=(?<depName>lycheeverse/lychee)[\\s\\S]{0,900}?lycheeverse/lychee:(?<currentValue>v?\\d[\\w.\\-]*)",
      ],
      datasourceTemplate: "docker",
    },
  ],

  // Keep the digests current alongside the tags. Every image that names a
  // version is pinned to its manifest-list digest, so a republished tag no
  // longer changes what runs without a pull request saying so. Multi-arch is
  // preserved: the pinned digest is the OCI image index, not a per-platform
  // manifest, verified against lscr.io/linuxserver/sonarr:4.0.19 whose index
  // carries four manifests.
  pinDigests: true,
}
