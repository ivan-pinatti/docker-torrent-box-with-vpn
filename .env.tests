# Profile overrides applied on top of .env by `make bootstrap_tests`
# (scripts/enable-test-profiles.sh), for a full test-coverage run.
#
# Only lines that need to change from .env.example's defaults belong here.
# Each profile below has real pytest coverage that never runs otherwise;
# see README.md's "Full test coverage" section for the reasoning and for
# which disabled profiles are deliberately NOT here (no-op stubs or
# services with zero test coverage either way).
#
# No secrets live in this file. It's tracked directly, unlike the
# .env.example / .env split docs/COMPOSE_CONVENTIONS.md documents for
# services that do carry real credentials.

WHISPARR_PROFILE=enabled
RECYCLARR_PROFILE=enabled
NZBHYDRA2_PROFILE=enabled

# NZBGET_PROFILE deliberately stays disabled, unlike its neighbors above.
# configs/nginx/templates/default.conf.template's /nzbget/ location block
# is itself commented out ("Legacy NZBGet endpoint retained for existing
# setups only"), the same "legacy, not actively maintained" framing
# .env.example already gives Jackett, so test_nzbget_api_auth's nginx-proxied
# request can never succeed here regardless of this profile's state,
# confirmed live. Enabling it would just trade one guaranteed-red test for
# another, not add real coverage.

CADVISOR_PROFILE=enabled
GRAFANA_PROFILE=enabled
LOKI_PROFILE=enabled
NODE_EXPORTER_PROFILE=enabled
PROMETHEUS_PROFILE=enabled
ALLOY_PROFILE=enabled
NGINX_EXPORTER_PROFILE=enabled
PODMAN_EXPORTER_PROFILE=enabled
PODMAN_LIMITS_EXPORTER_PROFILE=enabled
QBITTORRENT_EXPORTER_PROFILE=enabled
SABNZBD_EXPORTER_PROFILE=enabled

# Local, credential-free WireGuard endpoint so qBittorrent/SABnzbd (both
# depends_on: gluetun: condition: service_healthy) and everything wired
# through them can actually start without a real VPN provider account.
# scripts/enable-test-profiles.sh only acts on this if
# configs/gluetun/.secret is still empty/placeholder; a real key already in
# place is never overwritten. See docs/VPN_MOCK.md.
VPN_MOCK_PROFILE=enabled
